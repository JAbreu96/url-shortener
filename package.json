{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "test": "vitest run",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "fastify": "^4.28.1",
    "fastify-type-provider-zod": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^18.19.50",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^24.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  }
}
